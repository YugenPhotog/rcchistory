{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "herr-magister",
  "main": "src/worker.js",
  "account_id": "fffc85f812c2747d6720cf27271b0658",
  "compatibility_date": "2026-06-06",
  "compatibility_flags": [],
  "workers_dev": true,
  "preview_urls": false,
  "no_bundle": true,
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "logpush": false,
  "tail_consumers": []
}
